{
  "name": "inventum-backend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=.env src/index.ts",
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --packages=external --target=node24 --outfile=dist/index.js",
    "start": "node --env-file-if-exists=.env dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "NODE_ENV=test tsx --test src/*.test.ts",
    "test:db": "docker compose -f docker-compose.test.yml up -d --wait",
    "test:db:down": "docker compose -f docker-compose.test.yml down"
  },
  "dependencies": {
    "@fastify/compress": "^9.2.2",
    "@fastify/cookie": "^11.1.3",
    "@fastify/static": "^10.1.7",
    "aws4fetch": "^1.0.20",
    "fastify": "^5.12.7",
    "postgres": "^3.4.9",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2"
  }
}
