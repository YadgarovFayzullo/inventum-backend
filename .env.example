# Скопируйте в .env и заполните. Файл .env в git не попадает.

# Пароль базы данных (только буквы и цифры, чтобы не экранировать в адресе)
POSTGRES_PASSWORD=change-me-to-a-long-random-string

# Первый владелец создаётся при первом запуске. Если OWNER_PASSWORD пуст — сгенерируется и покажется в логе один раз.
OWNER_EMAIL=owner@inventum.uz
OWNER_PASSWORD=

# Cloudflare R2: R2 → Manage API tokens → Create API token (Object Read & Write). Бакет оставьте приватным.
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=

# Для запуска без Docker (npm run dev / npm start):
DATABASE_URL=postgres://inventum:change-me-to-a-long-random-string@127.0.0.1:5432/inventum
# PORT=3001

# За HTTPS (обязательно в интернете): 1
COOKIE_SECURE=0
TRUST_PROXY=0
